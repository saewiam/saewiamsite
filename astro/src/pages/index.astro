---
// TODO: create service functions for these

// get general website information
const infoResponse = await fetch(
    'http://payload:3000/api/globals/website-info?depth=2&draft=false&locale=undefined&trash=false'
)
const infoData: any = await infoResponse.json()
const title = infoData.title
const socials: any[] = infoData.socials

// get navigation link data
const navResponse = await fetch(
    'http://payload:3000/api/globals/navigation?depth=0&draft=false&trash=false'
)
const navData: any = await navResponse.json()
const links = navData.links.map((link: any) => {
    return {
        title: link.title,
        url: link.url,
        sublinks: link.sublinks.map((sublink: any) => {
            return {
                title: sublink.title,
                url: sublink.url,
            }
        }),
    }
})
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body>
        <h1>{title}</h1>
        <nav>
            <ul>
                {
                    links.map((link: any) => (
                        <li>
                            <a href={link.url}>{link.title}</a>
                            <ul>
                                {link.sublinks.map((sublink: any) => (
                                    <li>
                                        <a href={sublink.url}>
                                            {sublink.title}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </li>
                    ))
                }
            </ul>
        </nav>
    </body>
</html>
