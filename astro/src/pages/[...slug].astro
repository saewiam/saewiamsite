---
import type { GetStaticPaths } from 'astro'

import { getAllPages, getPageByURL } from '../repositories/Page.ts'

import DefaultLayout from '../layouts/DefaultLayout.astro'

import { Grid, ImageColumn } from '../models/Page'

import ImageColumnBlock from '../components/content-blocks/ImageColumnBlock.astro'
import GridBlock from '../components/content-blocks/GridBlock.astro'

const { slug } = Astro.params

/* STATIC BUILD PATHS */
/************ START ************/
export const getStaticPaths = (async () => {
    const pages = (await getAllPages()).map((page: any) => {
        return {
            params: { slug: page.url },
        }
    })
    return pages
}) satisfies GetStaticPaths
/************ END ************/

const page = await getPageByURL(slug)
---

<DefaultLayout>
    <h2>{page?.title || '404 not found'}</h2>
    {
        page?.content.map((block) => {
            if (block instanceof ImageColumn) {
                return (
                    <section>
                        <ImageColumnBlock content={block} />
                    </section>
                )
            }
            if (block instanceof Grid) {
                return (
                    <section>
                        <GridBlock content={block} />
                    </section>
                )
            }
        })
    }
</DefaultLayout>
