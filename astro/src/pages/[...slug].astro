---
import type { GetStaticPaths } from 'astro'

import { getAllPages, getPageByURL } from '../repositories/Page.ts'
import DefaultLayout from '../layouts/DefaultLayout.astro'

const { slug } = Astro.params

/* STATIC BUILD PATHS */
/************ START ************/
export const getStaticPaths = (async () => {
    const pages = getAllPages().map((page: any) => {
        return {
            params: { slug: page.url },
        }
    })
    return pages
}) satisfies GetStaticPaths
/************ END ************/

const page = await getPageByURL(slug)
---

{
    page ? (
        <DefaultLayout>
            <h2>{page.title}</h2>
        </DefaultLayout>
    ) : (
        <DefaultLayout>
            <h2>404 not found</h2>
        </DefaultLayout>
    )
}
