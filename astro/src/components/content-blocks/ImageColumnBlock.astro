---
import { ImageColumn } from '../../models/Page'

interface Props {
    content: ImageColumn
}

const { content } = Astro.props
---

<style>
    div {
        display: flex;
        flex-direction: column;
        flex: 1;
    }
</style>

<div>
    {content.images.map((image) => <img src={image} />)}
</div>
