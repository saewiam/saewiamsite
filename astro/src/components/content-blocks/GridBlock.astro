---
import { ImageColumn, Grid } from '../../models/Page'

import ImageColumnBlock from './ImageColumnBlock.astro'

interface Props {
    content: Grid
}

const { content } = Astro.props
---

<style>
    div {
        display: flex;
        flex-direction: row;
        width: 100%;
    }
    .column {
        flex: 1;
    }
</style>

<div>
    {
        content.columns.map((block) => {
            if (block instanceof ImageColumn) {
                return <ImageColumnBlock content={block} class="column" />
            }
        })
    }
</div>
