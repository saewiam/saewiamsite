---
import { getNavigationLinks } from '../repositories/NavigationLink.ts'

const links = await getNavigationLinks()
---

<style>
    * {
        padding: 0;
        list-style: none;
    }
    nav,
    ul,
    li {
        overflow: visible;
    }
    nav > ul {
        max-width: 800px;
        margin: auto;
        display: flex;
        align-items: baseline;
        & > li {
            display: block;
            flex-grow: 1;
            position: relative;
            a {
                display: block;
            }
            a:hover {
                background-color: #eee;
            }
            & > ul {
                visibility: none;
                display: none;

                position: absolute;
                width: 100%;
            }
            &:has(a:hover) > ul {
                visibility: visible;
                display: block;
            }
        }
    }
</style>

<nav>
    <ul>
        {
            links.map((link: any) => (
                <li>
                    <a href={link.url}>{link.title}</a>
                    <ul>
                        {link.sublinks.map((sublink: any) => (
                            <li>
                                <a href={sublink.url}>{sublink.title}</a>
                            </li>
                        ))}
                    </ul>
                </li>
            ))
        }
    </ul>
</nav>
